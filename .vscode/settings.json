{
  "editor.formatOnSave": true,
  "[java]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[jsp]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "files.associations": { "*.jsp": "jsp" },
  "prettier.documentSelectors": ["**/*.java", "**/*.jsp"],
  "prettier.requireConfig": true
}
